#!/bin/sh
# Block a commit whose documentation references something that no longer
# exists.
#
# Install (from the repo root):
#     ln -sf ../../tools/hooks/pre-commit .git/hooks/pre-commit
#
# It is a symlink to this tracked file, so editing this file updates the
# installed hook. .git/hooks is not tracked, so each clone installs its
# own -- this is a local convenience, not a guarantee about the repo.

cd "$(git rev-parse --show-toplevel)" || exit 0

# verify-docs reads pg_class to check object names, so it needs Postgres.
# A database that is merely down is NOT a documentation problem, and
# blocking every commit on it is how a hook teaches people to type -n out
# of habit -- after which it never fires on the real thing either. Warn
# and allow.
if ! uv run python -c "
import psycopg
from dera_pipeline import config
psycopg.connect(config.pg_dsn(), connect_timeout=3).close()
" >/dev/null 2>&1; then
    echo "pre-commit: database unreachable, skipping verify-docs." >&2
    echo "            Run 'uv run dera verify-docs' when it is back up." >&2
    exit 0
fi

if ! uv run dera verify-docs; then
    echo "" >&2
    echo "pre-commit: the docs reference something that does not exist." >&2
    echo "            Fix the reference above, or bypass with:" >&2
    echo "                git commit --no-verify" >&2
    exit 1
fi

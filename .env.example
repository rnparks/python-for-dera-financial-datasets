# Copy to .env and fill in. The dera CLI reads these at runtime.

# SEC requires a descriptive User-Agent with a contact email.
# Do not use a placeholder — SEC throttles generic strings.
SEC_USER_AGENT="Your Name <you@example.com>"

# Postgres connection string.
PG_DSN="postgresql://user:password@localhost:5432/dera"

# Optional: override where quarterly DERA dumps are stored (defaults to data/raw/).
# DERA_DATA_DIR="/absolute/path/to/data/raw"

# Optional: override where reference CSVs live (defaults to data/reference/).
# DERA_REFERENCE_DIR="/absolute/path/to/data/reference"
